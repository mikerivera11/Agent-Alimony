{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": {
      "value": "fsg"
    },
    "environmentName": {
      "value": "prod"
    },
    "location": {
      "value": "centralus"
    },
    "postgresAdminLogin": {
      "value": "REPLACE_WITH_ADMIN_LOGIN"
    },
    "appServicePlanSkuName": {
      "value": "P1v3"
    },
    "postgresSkuName": {
      "value": "Standard_B1ms"
    },
    "postgresSkuTier": {
      "value": "Burstable"
    },
    "postgresStorageSizeGB": {
      "value": 32
    },
    "postgresDatabaseName": {
      "value": "florida_support"
    },
    "enablePrivateNetworking": {
      "value": true
    },
    "logRetentionDays": {
      "value": 30
    },
    "tags": {
      "value": {
        "application": "florida-support-guide",
        "environment": "prod"
      }
    }
  }
}
