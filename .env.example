DATABASE_URL=postgres://postgres:postgres@localhost:5432/florida_support
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_UPLOAD_CONTAINER=case-documents
AZURE_PACKAGE_CONTAINER=generated-packages
AZURE_KEY_VAULT_URL=
EXTRACTION_PROVIDER=mock
AI_PROVIDER_API_KEY=
MAX_UPLOAD_BYTES=10485760

# Florida family-law information assistant.
# "local" answers from the app's built-in, citation-backed statute reference
# and needs no AI provider. "foundry" additionally uses Claude Opus 5 on
# Azure AI Foundry to rephrase those same passages in plainer language; it
# never supplies legal content or figures of its own.
ASSISTANT_PROVIDER=local
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_DEPLOYMENT=
# Leave blank in Azure and use the app's managed identity with the
# "Cognitive Services User" role on the Foundry resource.
AZURE_FOUNDRY_API_KEY=
