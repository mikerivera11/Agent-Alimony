DATABASE_URL=postgres://postgres:postgres@localhost:5432/florida_support
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/uploads
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_UPLOAD_CONTAINER=case-documents
AZURE_PACKAGE_CONTAINER=generated-packages
AZURE_KEY_VAULT_URL=
EXTRACTION_PROVIDER=mock
AI_PROVIDER_API_KEY=
MAX_UPLOAD_BYTES=10485760

# Florida family-law information assistant.
# "local" answers from the app's built-in, citation-backed statute reference
# and needs no AI provider. "foundry" additionally uses an Azure OpenAI GPT
# deployment to rephrase those same passages in plainer language; it never
# supplies legal content or figures of its own.
ASSISTANT_PROVIDER=local
# e.g. https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
# The deployment name you gave the model in Foundry, e.g. gpt-5.
AZURE_FOUNDRY_DEPLOYMENT=
# Azure OpenAI data-plane API version. Defaults to 2024-10-21; override if the
# deployed model requires a newer one.
AZURE_FOUNDRY_API_VERSION=
# Leave blank in Azure and use the app's managed identity with the
# "Cognitive Services OpenAI User" role on the Foundry resource.
AZURE_FOUNDRY_API_KEY=
